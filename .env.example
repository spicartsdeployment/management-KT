# ─────────────────────────────────────────────────────────────────────────────
# HRMS Frontend — environment template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# File loading order (Vite):
#   .env                  ← safe defaults, committed to git
#   .env.local            ← personal/machine overrides + SECRETS, git-ignored
#   .env.[mode]           ← mode-specific (development / production), committed
#   .env.[mode].local     ← mode-specific secrets, git-ignored
#
# NEVER commit .env.local or .env.*.local
# ─────────────────────────────────────────────────────────────────────────────

# ── Backend server URLs (fallback order: local → dev) ────────────────
# 1️⃣  Primary: internal-network server
VITE_API_LOCAL_SERVER=http://LOCAL_SERVER_IP:8000/api
# 2️⃣  Fallback: localhost dev server
VITE_API_DEV=http://localhost:8000/api

# ── WebSocket URLs (same fallback order) ─────────────────────────────────────
VITE_WS_LOCAL=ws://LOCAL_SERVER_IP:8000/ws
VITE_WS_SERVER=wss://EDGIANT_SOCKET_CONTAINER_URL/ws
VITE_WS_DEV=ws://localhost:8000/ws

# ── Microservice URLs ────────────────────────────────────────────────────────────
# Service-specific container app endpoints (Azure Container Apps or similar)
VITE_API_AUTH_SERVER=https://AUTH_CONTAINER_URL/authentication
VITE_API_ANNOUNCEMENTS_SERVER=https://ANNOUNCEMENTS_CONTAINER_URL
VITE_API_TEACHER_SERVER=https://TEACHER_CONTAINER_URL
VITE_WS_TEACHER_SERVER=wss://TEACHER_CONTAINER_URL/ws
# VITE_API_BUS_TRACKING_SERVER=https://BUS_TRACKING_CONTAINER_URL
# VITE_API_ALUMNI_SERVER=https://ALUMNI_CONTAINER_URL
# (Add more as services are migrated to microservice architecture)

# ── Environment ──────────────────────────────────────────────────────────────
VITE_NODE_ENV=development

# ── Feature flags ────────────────────────────────────────────────────────────
VITE_ENABLE_BUS_TRACKING=true
VITE_ENABLE_ATTENDANCE=true
VITE_ENABLE_COMMUNICATION=true

# ── Map configuration (bus tracking) ─────────────────────────────────────────
VITE_MAP_DEFAULT_CENTER_LAT=28.6139
VITE_MAP_DEFAULT_CENTER_LNG=77.2090
VITE_MAP_DEFAULT_ZOOM=12

# ─────────────────────────────────────────────────────────────────────────────
# SECRETS — put these in .env.local (never committed)
# Copy the block below into your .env.local and fill in real values
# ─────────────────────────────────────────────────────────────────────────────
# VITE_AUTH_SECRET=your_jwt_secret_here
# VITE_MAPS_API_KEY=your_google_maps_key_here
# VITE_SENTRY_DSN=https://your_sentry_dsn
