@use './variables' as *;
@use './mixins' as *;

// ═══════════════════════════════════════════════════════════════════════════
// BASE STYLES - All default/mobile-first styles here
// ═══════════════════════════════════════════════════════════════════════════

.ov-tasks-filters--fullwidth {
  display: flex;
  width: 100%;
  gap: 0.5rem;
  margin-bottom: 0.7rem;
}

.ov-task-filter-btn {
  flex: 1 1 0;
  justify-content: center;
  border-radius: 1.5rem;
  border: 1.5px solid #e2e8f0;
  background: #fff;
  min-width: 0;
  padding: 0.5rem 0.2rem;
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.85rem;
  font-weight: 600;
  color: #374151;
  transition: all 0.15s;

  [data-theme='dark'] & {
    background: #1e293b;
    border-color: #334155;
    color: #e2e8f0;
  }
}

.ov-task-filter-btn.active {
  background: #e0e7ff;
  border-color: #6366f1;
  color: #3730a3;

  [data-theme='dark'] & {
    background: #312e81;
    color: #a5b4fc;
  }
}

.ov-task-filter-badge {
  background: #f1f5f9;
  color: #64748b;
  border-radius: 1rem;
  padding: 0.1rem 0.7rem;
  font-size: 0.78rem;
  font-weight: 700;
  margin-left: 0.3rem;

  [data-theme='dark'] & {
    background: #334155;
    color: #e2e8f0;
  }
}

.ov-task-check {
  width: 32px;
  height: 32px;
  border-radius: 50%;
  border: 2.5px solid #cbd5e1;
  background: #fff;
  cursor: pointer;
  flex-shrink: 0;
  margin-top: 2px;
  margin-right: 0.7rem;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.15s;

  [data-theme='dark'] & {
    background: #1e293b;
    border-color: #334155;
  }
}

.ov-task-check.checked {
  background: #22c55e;
  border-color: #22c55e;
}

.ov-task-cat {
  border-radius: 1rem !important;
  background: none !important;
  color: #64748b;
  border: 1.5px solid #e2e8f0;
  padding: 0.1rem 0.9rem;
  font-weight: 600;

  [data-theme='dark'] & {
    background: #334155 !important;
    color: #e2e8f0;
    border-color: #475569;
  }
}

.ov-task-item.done {
  opacity: 0.7;
}

.ov-task-item.done .ov-task-title {
  text-decoration: line-through;
  color: #94a3b8;
}



.ov-summary-cards--fullwidth {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: stretch;
  gap: 2.5rem;

  @include respond-to(mobile) {
    gap: 1rem;
    flex-wrap: wrap;
  }
}

.ov-summary-cards--fullwidth .ov-summary-card {
  flex: 1 1 0;
  min-width: 0;
  justify-content: flex-start;

  @include respond-to(mobile) {
    // flex: 1 1 calc(50% - 0.5rem);
    dsiplay: flex;
    flex-direction: row;
    // justify-content: space-between;
    width: 100%;
    min-width: auto;
  }
}

.ov-link-footer--center {
  text-align: center !important;
  display: block;
  margin-left: auto;
  margin-right: auto;
}

// --- Overview Page ---------------------------------

.ov-page {
  //   padding: 1.5rem 1.75rem;
  min-height: 100vh;
  background: #f1f5f9;
  padding: 1.5rem 1.75rem;

  [data-theme='dark'] & {
    background: #0f172a;
  }

  @include respond-to(mobile) {
    padding: 1rem 0.75rem;
  }
}

// --- Greeting ----------------------------------
.ov-greeting-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 1.5rem;

  @include respond-to(mobile) {
    flex-direction: column;
    gap: 0.5rem;
  }
}

.ov-greeting__title {
  font-size: 2.3rem;
  font-weight: 900;
  color: #0f172a;
  margin: 0 0 0.25rem 0;

  [data-theme='dark'] & {
    color: #f1f5f9;
  }

  @include respond-to(mobile) {
    font-size: 1.6rem;
  }
}

.ov-greeting__sub {
  font-size: 1rem;
  font-weight: 700;
  color: #64748b;
  margin: 0;

  [data-theme='dark'] & {
    color: #94a3b8;
  }
}

.ov-greeting__date {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.8rem;
  color: #6366f1;
  font-weight: 500;
  white-space: nowrap;

  [data-theme='dark'] & {
    color: #a5b4fc;
  }
}

// --- Main 2-col grid ---------------------------
.ov-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;

  @include respond-to(tablet) {
    grid-template-columns: 1fr;
  }
}

.ov-full-width {
  grid-column: 1 / -1;
}

// --- Panels ------------------------------------
.ov-panel {
  background: #fff;
  border-radius: 16px;
  padding: 1.25rem;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.07);

  [data-theme='dark'] & {
    background: #1e293b;
    box-shadow: 0 1px 5px rgba(0, 0, 0, 0.3);
  }

  @include respond-to(mobile) {
    border-radius: 12px;
    padding: 1rem;
  }
}

.ov-panel__head {
  margin-bottom: 0.875rem;
}

.ov-panel__title {
  font-size: 0.9rem;
  font-weight: 700;
  color: #1e293b;
  margin: 0 0 0.15rem 0;

  [data-theme='dark'] & {
    color: #e2e8f0;
  }

  @include respond-to(mobile) {
    font-size: 0.85rem;
  }
}

.ov-panel__sub {
  font-size: 0.75rem;
  color: #94a3b8;
  margin: 0;
}

.ov-panel__head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0.875rem;
}

.ov-panel__head-icon {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  font-size: 0.875rem;
  font-weight: 700;
  color: #1e293b;

  [data-theme='dark'] & {
    color: #e2e8f0;
  }
}

// --- TODAY'S CLASSES ---------------------------
.ov-class-list {
  display: flex;
  flex-direction: column;
  gap: 0;
}

.ov-class-item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.6rem 0;
  border-bottom: 1px solid #f1f5f9;
  position: relative;

  [data-theme='dark'] & {
    border-color: #334155;
  }

  &:last-child {
    border-bottom: none;
  }

  &--live {
    background: #f0fdf4;
    margin: 0 -0.5rem;
    padding: 0.4rem;
    border-radius: 8px;
    border: 1.5px solid #bbf7d0;

    [data-theme='dark'] & {
      background: #052e16;
      border-color: #14532d;
    }

    @include respond-to(mobile) {
      margin: 0 -0.5rem;
      padding: 0.5rem 0.5rem;
    }
  }

  &--disabled {
    opacity: 0.6;

    .ov-class-item__name,
    .ov-class-item__time {
      color: #b0b7c3 !important;
      text-decoration: none;
    }
  }

  @include respond-to(mobile) {
    gap: 0.5rem;
    // padding: 0.5rem 0;
  }
}

.ov-class-item__time {
  width: 40px;
  font-size: 0.75rem;
  color: #64748b;
  font-weight: 500;
  flex-shrink: 0;
  padding-top: 2px;

  [data-theme='dark'] & {
    color: #94a3b8;
  }

  @include respond-to(mobile) {
    width: 35px;
    font-size: 0.7rem;
  }
}

.ov-class-item__dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-top: 5px;
  flex-shrink: 0;

  &--live {
    background: #22c55e;
    box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
  }

  &--done {
    background: #d1d5db;
  }

  &--upcoming {
    background: #d1d5db;
  }
}

.ov-class-item__content {
  flex: 1;
  min-width: 0;
}

.ov-class-item__name {
  font-size: 0.85rem;
  font-weight: 600;
  color: #1e293b;

  [data-theme='dark'] & {
    color: #e2e8f0;
  }

  @include respond-to(mobile) {
    font-size: 0.8rem;
  }
}

.ov-class-item__live-detail {
  margin-top: 0.3rem;
}

.ov-att-pct {
  font-size: 1.1rem;
  font-weight: 800;
  color: #22c55e;
}

.ov-att-sub {
  font-size: 0.78rem;
  color: #64748b;
}

.ov-class-item__room {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  font-size: 0.72rem;
  color: #64748b;
  margin-top: 0.25rem;

  [data-theme='dark'] & {
    color: #94a3b8;
  }
}

.ov-class-item__right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.4rem;
  flex-shrink: 0;

  @include respond-to(mobile) {
    gap: 0.2rem;
  }
}

// --- Badges / Buttons --------------------------
.ov-badge {
  font-size: 0.68rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  border-radius: 20px;

  &--done {
    background: #f1f5f9;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  &--live {
    background: none;
    color: #22c55e;
    padding: 0;
  }

  &--upcoming {
    color: #3b82f6;
    background: none;
    padding: 0;
    font-weight: 500;
  }

  &--count-red {
    background: #ef4444;
    color: #fff;
  }

  &--count-gray {
    background: #e2e8f0;
    color: #374151;

    [data-theme='dark'] & {
      background: #334155;
      color: #e2e8f0;
    }
  }
}

.ov-btn-mark {
  background: #22c55e;
  color: #fff;
  border: none;
  padding: 0.4rem 0.8rem;
  border-radius: 8px;
  font-size: 0.75rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  gap: 0.35rem;
  white-space: nowrap;
  transition: background 0.15s;

  &:hover {
    background: #16a34a;
  }

  @include respond-to(mobile) {
    padding: 0.35rem 0.6rem;
    font-size: 0.7rem;
    gap: 0.25rem;
  }
}

.ov-link-footer {
  display: block;
  text-align: right;
  font-size: 0.78rem;
  color: #3b82f6;
  text-decoration: none;
  margin-top: 0.875rem;
  font-weight: 500;

  &:hover {
    text-decoration: underline;
  }
}

.ov-link-sm {
  font-size: 0.78rem;
  color: #3b82f6;
  background: none;
  border: none;
  cursor: pointer;
  font-weight: 500;
  text-decoration: none;

  &:hover {
    text-decoration: underline;
  }
}

// --- Right column ------------------------------
.ov-right-col {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;

  &--stack {
    gap: 1.25rem;
  }
}

// --- Today Summary -----------------------------

.ov-summary-cards {
  display: flex;
  gap: 1.5rem;
  margin-top: 0.5rem;
  align-items: center;

  @include respond-to(mobile) {
    gap: 1rem;
  }
}

.ov-summary-card {
  display: flex;
  align-items: center;
  gap: 0.75rem;

  @include respond-to(mobile) {
    gap: 0.6rem;
    padding: 0.5rem;
    flex-direction: column;
    text-align: center;
  }

  &__icon {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;

    &--blue {
      background: #eff6ff;
      color: #3b82f6;
    }

    &--purple {
      background: #f5f3ff;
      color: #7c3aed;
    }

    &--orange {
      background: #fff7ed;
      color: #ea580c;
    }
  }

  &__num {
    display: block;
    font-size: 1.4rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1;

    [data-theme='dark'] & {
      color: #e2e8f0;
    }

    @include respond-to(mobile) {
      font-size: 1.2rem;
    }
  }

  &__lbl {
    display: block;
    font-size: 0.72rem;
    color: #64748b;
    margin-top: 0.1rem;

    [data-theme='dark'] & {
      color: #94a3b8;
    }

    @include respond-to(mobile) {
      font-size: 0.68rem;
    }
  }
}

// --- Work + Compliance row ---------------------
.ov-work-compliance-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;

  @include respond-to(mobile) {
    grid-template-columns: 1fr;
  }
}


.ov-work__row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 0.8rem;
  color: #374151;
  margin-bottom: 0.6rem;

  [data-theme='dark'] & {
    color: #cbd5e1;
  }
}

.ov-work__count {
  font-weight: 700;
  color: #1e293b;
  display: flex;
  align-items: center;
  gap: 0.2rem;

  [data-theme='dark'] & {
    color: #e2e8f0;
  }
}

.ov-btn-review {
  width: 100%;
  background: #1e3a5f;
  color: #fff;
  border: none;
  padding: 0.65rem;
  border-radius: 8px;
  font-size: 0.82rem;
  font-weight: 600;
  cursor: pointer;
  margin-bottom: 0.75rem;
  transition: background 0.15s;

  &:hover {
    background: #3b82f6;
  }
}

.ov-work__actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.6rem;

  @include respond-to(mobile) {
    gap: 0.5rem;
  }
}

.ov-work__action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.4rem;
  padding: 0.75rem 0.5rem;
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  background: #fff;
  font-size: 0.72rem;
  font-weight: 500;
  color: #374151;
  cursor: pointer;
  transition: all 0.15s;

  &:hover {
    background: #f8fafc;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  [data-theme='dark'] & {
    background: #0f172a;
    border-color: #334155;
    color: #cbd5e1;
  }

  @include respond-to(mobile) {
    padding: 0.6rem 0.4rem;
    font-size: 0.68rem;
    gap: 0.3rem;
  }
}

.ov-work__action-icon {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;

  @include respond-to(mobile) {
    width: 32px;
    height: 32px;
  }

  &--blue {
    background: #eff6ff;
    color: #3b82f6;
  }

  &--orange {
    background: #fff7ed;
    color: #ea580c;
  }
}

// --- Compliance --------------------------------

.ov-compliance-item {
  margin-bottom: 0.9rem;

  &:last-child {
    margin-bottom: 0;
  }

  &__header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: #374151;
    margin-bottom: 0.2rem;

    [data-theme='dark'] & {
      color: #cbd5e1;
    }

    span:last-of-type {
      margin-left: auto;
      font-weight: 700;
      font-size: 0.9rem;
      color: #1e293b;

      [data-theme='dark'] & {
        color: #e2e8f0;
      }
    }
  }

  &__icon {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;

    &--blue {
      background: #eff6ff;
      color: #3b82f6;
    }

    &--purple {
      background: #f5f3ff;
      color: #7c3aed;
    }
  }

  &__sub {
    font-size: 0.7rem;
    color: #64748b;
    margin: 0 0 0.4rem 0;

    [data-theme='dark'] & {
      color: #94a3b8;
    }
  }
}

// --- Progress bar ------------------------------
.ov-progress-bar {
  height: 6px;
  background: #e2e8f0;
  border-radius: 3px;
  overflow: hidden;

  [data-theme='dark'] & {
    background: #334155;
  }

  &__fill {
    height: 100%;
    border-radius: 3px;
    transition: width 0.4s;

    &--green {
      background: #22c55e;
    }

    &--blue {
      background: linear-gradient(90deg, #3b82f6, #6366f1);
    }
  }
}

// --- Student Alerts ----------------------------

.ov-alert-card {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.7rem;
  border-radius: 10px;
  margin-bottom: 0.6rem;
  border: 1px solid transparent;

  &:last-of-type {
    margin-bottom: 0;
  }

  @include respond-to(mobile) {
    gap: 0.6rem;
    padding: 0.6rem;
    margin-bottom: 0.5rem;
  }

  &--error {
    background: #fef2f2;
    border-color: #fecaca;

    [data-theme='dark'] & {
      background: #450a0a;
      border-color: #7f1d1d;
    }
  }

  &--warning {
    background: #fffbeb;
    border-color: #fde68a;

    [data-theme='dark'] & {
      background: #451a03;
      border-color: #78350f;
    }
  }

  &--purple {
    background: #f5f3ff;
    border-color: #ddd6fe;

    [data-theme='dark'] & {
      background: #2e1065;
      border-color: #4c1d95;
    }
  }

  &--success {
    background: #f0fdf4;
    border-color: #bbf7d0;

    [data-theme='dark'] & {
      background: #052e16;
      border-color: #14532d;
    }
  }

  &--info {
    background: #eff6ff;
    border-color: #bfdbfe;

    [data-theme='dark'] & {
      background: #0c1a2e;
      border-color: #1e3a5f;
    }
  }

  &__icon {
    font-size: 1rem;
    margin-top: 1px;
    flex-shrink: 0;
  }

  &__title {
    font-size: 0.82rem;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 0.2rem;

    [data-theme='dark'] & {
      color: #e2e8f0;
    }

    @include respond-to(mobile) {
      font-size: 0.78rem;
    }
  }

  &__desc {
    font-size: 0.75rem;
    color: #374151;
    line-height: 1.4;

    [data-theme='dark'] & {
      color: #cbd5e1;
    }

    @include respond-to(mobile) {
      font-size: 0.7rem;
      line-height: 1.3;
    }
  }

  &__time {
    font-size: 0.68rem;
    color: #94a3b8;
    margin-top: 0.2rem;
  }
}

// --- Announcements -----------------------------
.ov-ann-new {
  display: flex;
  gap: 0.5rem;
  margin-bottom: 0.75rem;

  &__input {
    flex: 1;
    border: 1px solid #e2e8f0;
    border-radius: 7px;
    padding: 0.4rem 0.65rem;
    font-size: 0.8rem;
    outline: none;

    &:focus {
      border-color: #3b82f6;
    }

    [data-theme='dark'] & {
      background: #0f172a;
      border-color: #334155;
      color: #e2e8f0;
    }
  }

  &__save {
    background: #3b82f6;
    color: #fff;
    border: none;
    padding: 0.4rem 0.9rem;
    border-radius: 7px;
    font-size: 0.8rem;
    cursor: pointer;
    transition: background 0.15s;

    &:hover {
      background: #2563eb;
    }
  }
}

.ov-ann-item {
  display: flex;
  align-items: flex-start;
  gap: 0.6rem;
  padding: 0.5rem 0;
  border-bottom: 1px solid #f1f5f9;

  [data-theme='dark'] & {
    border-color: #334155;
  }

  &:last-of-type {
    border-bottom: none;
  }
}

.ov-ann-dot {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  margin-top: 4px;
  flex-shrink: 0;
}

.ov-ann-item__title {
  font-size: 0.82rem;
  font-weight: 500;
  color: #1e293b;

  [data-theme='dark'] & {
    color: #e2e8f0;
  }
}

.ov-ann-item__sub {
  font-size: 0.72rem;
  font-weight: 600;
  margin-top: 0.1rem;
}

// --- Tasks -------------------------------------

.ov-tasks-panel__header {
  align-items: flex-start !important;
}

.ov-tasks-title-group {
  display: flex;
  align-items: center;
  gap: 0.65rem;
}

.ov-tasks-title-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  background: #1e3a5f;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;

  &--purple {
    background: #7c3aed;
  }

  &--green {
    background: #16a34a;
  }

  &--orange {
    background: #ea580c;
  }
}

.ov-tasks-panel__title {
  font-size: 0.9rem;
  font-weight: 700;
  color: #1e293b;

  [data-theme='dark'] & {
    color: #e2e8f0;
  }
}

.ov-tasks-panel__sub {
  font-size: 0.72rem;
  color: #64748b;

  [data-theme='dark'] & {
    color: #94a3b8;
  }
}

.ov-tasks-progress-label {
  text-align: right;

  span:first-child {
    display: block;
    font-size: 0.68rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
}

.ov-tasks-progress-pct {
  font-size: 1.2rem;
  font-weight: 800;
  color: #3b82f6;
}

.ov-tasks-filter-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 0.875rem;
  flex-wrap: wrap;

  @include respond-to(mobile) {
    gap: 0.5rem;
    margin-bottom: 0.75rem;
  }
}

.ov-tasks-filter-label {
  font-size: 0.68rem;
  font-weight: 700;
  color: #64748b;
  text-transform: uppercase;
  letter-spacing: 0.05em;
}

.ov-tasks-count {
  font-size: 0.72rem;
  color: #94a3b8;
  margin-left: auto;
}

.ov-tasks-filters {
  display: flex;
  gap: 4px;
}

.ov-task-filter-btn {
  display: flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.35rem 0.7rem;
  border: none;
  border-radius: 7px;
  font-size: 0.75rem;
  font-weight: 500;
  color: #64748b;
  background: #f1f5f9;
  cursor: pointer;
  transition: all 0.15s;

  [data-theme='dark'] & {
    background: #334155;
    color: #94a3b8;
  }

  &.active {
    background: #1e3a5f;
    color: #fff;
  }

  &.red .ov-task-filter-badge {
    background: #ef4444 !important;
  }

  &.active .ov-task-filter-badge {
    background: rgba(255, 255, 255, 0.3);
  }
}

.ov-task-filter-badge {
  background: #e2e8f0;
  color: #374151;
  border-radius: 10px;
  padding: 0 5px;
  font-size: 0.65rem;
  font-weight: 700;

  [data-theme='dark'] & {
    background: #475569;
    color: #e2e8f0;
  }
}

.ov-task-list {
  display: flex;
  flex-direction: column;
  max-height: 300px;
  overflow-y: auto;
  gap: 0;
  scrollbar-width: thin;
  scrollbar-color: #e2e8f0 transparent;

  @include respond-to(mobile) {
    max-height: 350px;
  }
}

.ov-task-item {
  display: flex;
  align-items: flex-start;
  gap: 0.75rem;
  padding: 0.65rem 0.5rem;
  border-radius: 8px;
  transition: background 0.15s;
  position: relative;

  &:hover {
    background: #f8fafc;

    [data-theme='dark'] & {
      background: #0f172a;
    }
  }

  &.done {
    opacity: 0.55;

    .ov-task-title {
      text-decoration: line-through;
      color: #94a3b8;
    }
  }

  &.overdue {
    background: #fef2f2;

    [data-theme='dark'] & {
      background: #450a0a;
    }
  }

  @include respond-to(mobile) {
    gap: 0.6rem;
    padding: 0.55rem 0.4rem;
  }
}

.ov-task-check {
  width: 18px;
  height: 18px;
  border-radius: 50%;
  border: 2px solid #cbd5e1;
  background: none;
  cursor: pointer;
  flex-shrink: 0;
  margin-top: 2px;
  transition: all 0.15s;

  &.checked {
    background: #22c55e;
    border-color: #22c55e;
  }

  &:hover {
    border-color: #3b82f6;
  }
}

.ov-task-body {
  flex: 1;
  min-width: 0;
}

.ov-task-title {
  font-size: 0.82rem;
  font-weight: 500;
  color: #1e293b;
  margin-bottom: 0.3rem;
  line-height: 1.3;

  [data-theme='dark'] & {
    color: #e2e8f0;
  }

  @include respond-to(mobile) {
    font-size: 0.78rem;
    margin-bottom: 0.2rem;
  }
}

.ov-task-meta {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  flex-wrap: wrap;

  @include respond-to(mobile) {
    gap: 0.35rem;
    font-size: 0.65rem;
  }
}

.ov-task-cat {
  font-size: 0.68rem;
  color: #fff;
  background: #64748b;
  border-radius: 4px;
  padding: 0.1rem 0.5rem;
}

.ov-task-due {
  font-size: 0.68rem;
  color: #64748b;
  display: flex;
  align-items: center;
  gap: 0.2rem;

  @include respond-to(mobile) {
    font-size: 0.65rem;
  }
}

.ov-task-priority-badge {
  font-size: 0.65rem;
  font-weight: 700;
  color: #fff;
  background: #ef4444;
  border-radius: 4px;
  padding: 0.1rem 0.4rem;
}

.ov-task-badge-time {
  font-size: 0.65rem;
  font-weight: 600;
  border-radius: 4px;
  padding: 0.1rem 0.5rem;

  &--overdue {
    background: #fee2e2;
    color: #dc2626;
  }

  &--today {
    background: #dbeafe;
    color: #1d4ed8;
  }

  &--urgent {
    background: #fff7ed;
    color: #c2410c;
  }
}

.ov-task-urgent-dot {
  width: 8px;
  height: 8px;
  background: #ef4444;
  border-radius: 50%;
  flex-shrink: 0;
  margin-top: 4px;
}

.ov-task-progress-section {
  margin-top: 1rem;
  margin-bottom: 0.75rem;
}

.ov-task-progress-label {
  display: flex;
  justify-content: space-between;
  font-size: 0.72rem;
  color: #64748b;
  margin-bottom: 0.4rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.04em;
}

.ov-btn-submit-tasks {
  width: 100%;
  background: #1e3a5f;
  color: #fff;
  border: none;
  padding: 0.75rem;
  border-radius: 10px;
  font-size: 0.85rem;
  font-weight: 600;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  transition: background 0.15s;
  margin-top: 0.5rem;

  &:hover {
    background: #3b82f6;
  }
}

// --- Notice Board ------------------------------
.ov-notice-list {
  display: flex;
  flex-direction: column;
  max-height: 400px;
  overflow-y: auto;
  gap: 0.6rem;
  scrollbar-width: thin;

  @include respond-to(mobile) {
    gap: 0.5rem;
    max-height: 350px;
  }
}

.ov-notice-item {
  border: 1px solid #e2e8f0;
  border-radius: 10px;
  padding: 0.75rem;
  transition: opacity 0.2s;

  [data-theme='dark'] & {
    border-color: #334155;
  }

  &.read {
    opacity: 0.5;
  }

  @include respond-to(mobile) {
    border-radius: 8px;
    padding: 0.65rem;
  }

  &__header {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;

    @include respond-to(mobile) {
      margin-bottom: 0.4rem;
    }
  }

  &__time {
    font-size: 0.68rem;
    color: #94a3b8;
    margin-left: auto;
  }

  &__body {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;

    @include respond-to(mobile) {
      gap: 0.5rem;
    }
  }

  &__icon {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1rem;
    flex-shrink: 0;
    color: #fff;

    @include respond-to(mobile) {
      width: 30px;
      height: 30px;
      font-size: 0.9rem;
    }
  }

  &__title {
    font-size: 0.82rem;
    font-weight: 600;
    color: #1e293b;
    margin-bottom: 0.2rem;

    [data-theme='dark'] & {
      color: #e2e8f0;
    }

    @include respond-to(mobile) {
      font-size: 0.78rem;
    }
  }

  &__desc {
    font-size: 0.72rem;
    color: #64748b;
    line-height: 1.4;

    [data-theme='dark'] & {
      color: #94a3b8;
    }

    @include respond-to(mobile) {
      font-size: 0.68rem;
      line-height: 1.3;
    }
  }

  &__tags {
    display: flex;
    gap: 0.3rem;
    flex-wrap: wrap;
    margin-top: 0.35rem;
  }
}

.ov-mark-read-btn {
  display: flex;
  align-items: center;
  gap: 0.25rem;
  font-size: 0.65rem;
  font-weight: 700;
  color: #64748b;
  background: none;
  border: 1px solid #e2e8f0;
  border-radius: 5px;
  padding: 0.15rem 0.5rem;
  cursor: pointer;
  margin-left: auto;
  transition: all 0.15s;

  &:hover {
    background: #f1f5f9;
    color: #374151;
  }

  [data-theme='dark'] & {
    border-color: #475569;
    color: #94a3b8;
  }
}

// --- Tags --------------------------------------
.ov-badge {
  font-size: 0.68rem;
  font-weight: 700;
  padding: 0.2rem 0.6rem;
  border-radius: 20px;

  &--done {
    background: #f1f5f9;
    color: #64748b;
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }

  &--live {
    background: #e0f7f4;
    color: #22c55e;
    padding: 0.2rem 0.7rem;
    border-radius: 16px;
    font-weight: 700;
    margin-bottom: 0.3rem;
    box-shadow: 0 1px 4px rgba(34, 197, 94, 0.07);
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
  }

  &--upcoming {
    color: #3b82f6;
    background: none;
    padding: 0;
    font-weight: 500;
  }

  &--count-red {
    background: #ef4444;
    color: #fff;
  }

  &--gray {
    background: #64748b;
    color: #fff;
  }
}

// --- Performance Analytics ---------------------

.ov-perf-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1.25rem;
}

.ov-perf-live-dot {
  display: flex;
  align-items: center;
  gap: 0.35rem;
  font-size: 0.72rem;
  color: #64748b;
}

.ov-dot--green {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #22c55e;
  display: inline-block;
}

.ov-btn-live {
  display: flex;
  align-items: center;
  gap: 0.4rem;
  border: 1px solid #e2e8f0;
  background: #fff;
  color: #374151;
  border-radius: 8px;
  padding: 0.45rem 0.9rem;
  font-size: 0.78rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;

  &:hover {
    background: #f1f5f9;
  }

  [data-theme='dark'] & {
    background: #334155;
    border-color: #475569;
    color: #e2e8f0;
  }
}

.ov-perf-metrics {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0.875rem;
  margin-bottom: 1.5rem;

  @include respond-to(tablet) {
    grid-template-columns: repeat(2, 1fr);
  }

  @include respond-to(mobile) {
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
}

.ov-perf-metric {
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 0.875rem;

  [data-theme='dark'] & {
    border-color: #334155;
  }

  &__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  &__icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
    font-weight: 700;
  }

  &__delta {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.5rem;
    border-radius: 20px;

    &--green {
      background: #dcfce7;
      color: #16a34a;
    }

    &--red {
      background: #fee2e2;
      color: #dc2626;
    }
  }

  &__value {
    font-size: 1.6rem;
    font-weight: 800;
    line-height: 1;
    margin-bottom: 0.2rem;
  }

  &__label {
    font-size: 0.65rem;
    font-weight: 600;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
}

// --- AI Recs -----------------------------------
.ov-ai-recs-section {
  margin-bottom: 1.5rem;
}

.ov-ai-recs-title {
  display: flex;
  align-items: center;
  gap: 0.65rem;
  font-size: 0.9rem;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 0.875rem;

  [data-theme='dark'] & {
    color: #e2e8f0;
  }
}


.ov-ai-recs-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 0.875rem;

  @include respond-to(tablet) {
    grid-template-columns: 1fr;
  }

  @include respond-to(mobile) {
    gap: 0.75rem;
  }
}

.ov-ai-rec {
  border-radius: 12px;
  padding: 1rem;
  border: 1px solid transparent;

  @include respond-to(mobile) {
    padding: 0.85rem;
  }

  &__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
  }

  &__icon {
    font-size: 1.1rem;
  }

  &__priority {
    font-size: 0.65rem;
    font-weight: 700;
    color: #fff;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
  }

  &__title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.4rem;

    [data-theme='dark'] & {
      color: #e2e8f0;
    }

    @include respond-to(mobile) {
      font-size: 0.8rem;
      margin-bottom: 0.3rem;
    }
  }

  &__desc {
    font-size: 0.75rem;
    color: #374151;
    line-height: 1.5;
    margin-bottom: 0.6rem;

    [data-theme='dark'] & {
      color: #cbd5e1;
    }

    @include respond-to(mobile) {
      font-size: 0.7rem;
      line-height: 1.4;
      margin-bottom: 0.5rem;
    }
  }

  &__action {
    background: none;
    border: none;
    font-size: 0.75rem;
    font-weight: 600;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.3rem;

    @include respond-to(mobile) {
      font-size: 0.7rem;
    }
  }
}

// --- Charts ------------------------------------
.ov-charts-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-bottom: 1rem;

  @include respond-to(tablet) {
    grid-template-columns: 1fr;
  }
}

.ov-chart-panel {
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 1rem;
  background: #fff;

  [data-theme='dark'] & {
    background: #0f172a;
    border-color: #334155;
  }

  &--full {
    width: 100%;
    box-sizing: border-box;
  }

  &__head {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    font-weight: 700;
    color: #1e293b;
    margin-bottom: 0.75rem;

    [data-theme='dark'] & {
      color: #e2e8f0;
    }
  }
}

.ov-bar-chart {
  width: 100%;
  overflow-x: auto;
}

// --- Performers --------------------------------
.ov-performers-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
  margin-top: 1rem;

  @include respond-to(tablet) {
    grid-template-columns: 1fr;
  }
}

.ov-performer-panel {
  border-radius: 12px;
  padding: 1rem;
  border: 1px solid transparent;

  @include respond-to(mobile) {
    border-radius: 10px;
    padding: 0.85rem;
  }

  &--green {
    background: linear-gradient(135deg, #f0fdf4, #dcfce7);
    border-color: #bbf7d0;

    [data-theme='dark'] & {
      background: #052e16;
      border-color: #14532d;
    }
  }

  &--orange {
    background: linear-gradient(135deg, #fffbeb, #fef3c7);
    border-color: #fde68a;

    [data-theme='dark'] & {
      background: #451a03;
      border-color: #78350f;
    }
  }
}

.ov-performer-row {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.55rem 0;
  border-bottom: 1px solid rgba(0, 0, 0, 0.05);

  [data-theme='dark'] & {
    border-color: rgba(255, 255, 255, 0.05);
  }

  &:last-child {
    border-bottom: none;
  }

  @include respond-to(mobile) {
    gap: 0.6rem;
    padding: 0.45rem 0;
  }
}

.ov-performer-rank {
  width: 24px;
  height: 24px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 0.72rem;
  font-weight: 800;
  color: #fff;
  flex-shrink: 0;

  &--green {
    background: #22c55e;
  }
}

.ov-performer-icon-orange {
  width: 28px;
  height: 28px;
  border-radius: 7px;
  background: #ea580c;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ov-performer-info {
  flex: 1;
}

.ov-performer-name {
  font-size: 0.82rem;
  font-weight: 600;
  color: #1e293b;

  [data-theme='dark'] & {
    color: #e2e8f0;
  }

  @include respond-to(mobile) {
    font-size: 0.78rem;
  }
}

.ov-performer-cls {
  font-size: 0.7rem;
  color: #64748b;

  @include respond-to(mobile) {
    font-size: 0.65rem;
  }
}

.ov-performer-score {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 0.1rem;

  .green {
    color: #16a34a;
    font-weight: 700;
  }

  .red {
    color: #dc2626;
    font-weight: 700;
  }

  .small {
    font-size: 0.7rem;
  }
}

@media (max-width: 550px) {

  // ── Hard overflow kill-switch ──────────────────────────────
  // Every panel, card, row, and list must fit inside the viewport.
  .ov-page {
    overflow-x: hidden;
    width: 100%;
    box-sizing: border-box;
  }

  // Force every direct descendant to be width-constrained
  .ov-page *,
  .ov-panel,
  .ov-grid,
  .ov-right-col,
  .ov-summary-cards--fullwidth,
  .ov-summary-card,
  .ov-work-compliance-row,
  .ov-perf-metrics,
  .ov-perf-metric,
  .ov-charts-row,
  .ov-chart-panel,
  .ov-performers-row,
  .ov-performer-panel,
  .ov-ai-recs-grid,
  .ov-ai-rec,
  .ov-notice-list,
  .ov-notice-item,
  .ov-alert-card,
  .ov-task-item,
  .ov-class-item {
    box-sizing: border-box;
    max-width: 100%;
    min-width: 0; // removes the flex/grid child implicit min-width:auto
  }

  // ── Page padding ──────────────────────────────────────────
  .ov-page {
    padding: 0.875rem 0.625rem;
  }

  // ── Main two-column grid → single column ──────────────────
  // This is the biggest structural fix. .ov-grid is 1fr 1fr at
  // desktop and nothing overrode it below the mixin breakpoint.
  .ov-grid {
    grid-template-columns: 1fr !important;
    gap: 0.875rem;
    width: 100%;
  }

  // ── Right column stack ────────────────────────────────────
  .ov-right-col {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    width: 100%;
  }

  // ── All panels full-width ─────────────────────────────────
  .ov-panel {
    width: 100%;
    padding: 0.875rem 0.75rem;
    border-radius: 10px;
  }

  // ── work / compliance row → single column ─────────────────
  .ov-work-compliance-row {
    grid-template-columns: 1fr !important;
    gap: 0.875rem;
  }

  // ── Perf metrics 4-col → 2-col ────────────────────────────
  .ov-perf-metrics {
    grid-template-columns: 1fr 1fr !important;
    gap: 0.625rem;
  }

  // ── Charts row → single column ────────────────────────────
  .ov-charts-row {
    grid-template-columns: 1fr !important;
    gap: 0.75rem;
  }

  // Each chart panel fills available width
  .ov-chart-panel {
    width: 100%;
    padding: 0.875rem;
  }

  // ── Performers row → single column ───────────────────────
  .ov-performers-row {
    grid-template-columns: 1fr !important;
    gap: 0.75rem;
  }

  // ── AI recs → already goes 1-col via tablet mixin,
  //    but ensure gap is tight
  .ov-ai-recs-grid {
    grid-template-columns: 1fr !important;
    gap: 0.75rem;
  }

  // ── Summary cards strip ───────────────────────────────────
  // flex:1 1 0 with gap:2.5rem causes cards to squash.
  // Keep them in a row but shrink everything.
  .ov-summary-cards--fullwidth {
    gap: 0.5rem;
    flex-wrap: nowrap; // intentional: keep them in one row
    align-items: stretch;
  }

  .ov-summary-cards--fullwidth .ov-summary-card {
    flex: 1 1 0;
    min-width: 0;
    padding: 0.25rem 0;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.3rem;
  }

  .ov-summary-card__icon {
    width: 32px;
    height: 32px;
    border-radius: 7px;
    flex-shrink: 0;
  }

  .ov-summary-card__num {
    font-size: 1rem;
    line-height: 1;
  }

  .ov-summary-card__lbl {
    font-size: 0.6rem;
    margin-top: 0.05rem;
  }

  // ── Greeting ──────────────────────────────────────────────
  .ov-greeting-row {
    flex-direction: column;
    gap: 0.35rem;
    margin-bottom: 1rem;
  }

  .ov-greeting__title {
    font-size: 1.4rem;
  }

  .ov-greeting__sub {
    font-size: 0.85rem;
  }

  .ov-greeting__date {
    white-space: normal;
    flex-wrap: wrap;
    font-size: 0.72rem;
  }

  // ── Today's classes ───────────────────────────────────────
  .ov-class-item {
    gap: 0.5rem;
    padding: 0.55rem 0.2rem;

    &--live {
      margin: 0 -0.05rem;
      // padding: 0.65rem 0.75rem;
    }
  }

  .ov-class-item__time {
    width: 30px;
    font-size: 0.68rem;
    flex-shrink: 0;
  }

  .ov-class-item__name {
    font-size: 0.78rem;
  }

  .ov-class-item__room {
    font-size: 0.65rem;
  }

  // ── Task filter pill row ──────────────────────────────────
  .ov-tasks-filters {
    flex-wrap: wrap;
    gap: 3px;
  }

  .ov-tasks-filters--fullwidth {
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-bottom: 0.6rem;
  }

  .ov-task-filter-btn {
    flex: 1 1 auto;
    font-size: 0.7rem;
    padding: 0.28rem 0.5rem;
  }

  // ── Task items ────────────────────────────────────────────
  .ov-task-item {
    gap: 0.5rem;
    padding: 0.6rem 0.4rem;
  }

  // Large circle check (first ruleset in source)
  .ov-task-check {
    width: 24px;
    height: 24px;
    margin-right: 0.5rem;
    flex-shrink: 0;
  }

  .ov-task-title {
    font-size: 0.78rem;
  }

  .ov-task-due {
    font-size: 0.63rem;
  }

  .ov-task-cat {
    font-size: 0.63rem;
  }

  // ── Notice board ─────────────────────────────────────────
  .ov-notice-item {
    padding: 0.65rem 0.55rem;

    &__title {
      font-size: 0.78rem;
    }

    &__desc {
      font-size: 0.68rem;
    }
  }

  // ── Alert cards ───────────────────────────────────────────
  .ov-alert-card {
    padding: 0.6rem 0.5rem;
    gap: 0.5rem;

    &__title {
      font-size: 0.78rem;
    }

    &__desc {
      font-size: 0.7rem;
    }
  }

  // ── Work action grid ──────────────────────────────────────
  .ov-work__actions {
    gap: 0.5rem;
  }

  .ov-work__action-btn {
    padding: 0.6rem 0.3rem;
    font-size: 0.65rem;
  }

  .ov-work__action-icon {
    width: 28px;
    height: 28px;
    flex-shrink: 0;
  }

  // ── Btn mark ─────────────────────────────────────────────
  .ov-btn-mark {
    white-space: normal;
    padding: 0.35rem 0.55rem;
    font-size: 0.68rem;
  }

  // ── Perf metrics ─────────────────────────────────────────
  .ov-perf-metric {
    padding: 0.75rem;
    border-radius: 10px;

    &__value {
      font-size: 1.3rem;
    }

    &__label {
      font-size: 0.62rem;
    }

    &__icon {
      width: 32px;
      height: 32px;
      font-size: 0.9rem;
    }
  }

  // ── AI recs ───────────────────────────────────────────────
  .ov-ai-rec {
    padding: 0.75rem;

    &__title {
      font-size: 0.82rem;
    }

    &__desc {
      font-size: 0.72rem;
    }
  }

  // ── Performer panels ──────────────────────────────────────
  .ov-performer-panel {
    padding: 0.75rem;
  }

  .ov-performer-name {
    font-size: 0.78rem;
  }

  // ── Panel header text ─────────────────────────────────────
  .ov-panel__title {
    font-size: 0.85rem;
  }

  .ov-panel__sub {
    font-size: 0.7rem;
  }

  // ── Buttons ───────────────────────────────────────────────
  .ov-btn-submit-tasks {
    padding: 0.65rem;
    font-size: 0.82rem;
  }

  .ov-btn-review {
    padding: 0.6rem;
    font-size: 0.8rem;
  }
}


// ────────────────────────────────────────────────────────────────
// 1.  480px  — tighter spacing, 1-col metrics
// ────────────────────────────────────────────────────────────────
@media (max-width: 480px) {

  .ov-page {
    padding: 0.75rem 0.5rem;
  }

  // ── Greeting ──────────────────────────────────────────────
  .ov-greeting__title {
    font-size: 1.25rem;
  }

  .ov-greeting__sub {
    font-size: 0.8rem;
  }

  .ov-greeting__date {
    font-size: 0.68rem;
  }

  // ── Panels ────────────────────────────────────────────────
  .ov-panel {
    padding: 0.75rem 0.625rem;
  }

  // ── Perf metrics → 1-col with horizontal inner layout ─────
  .ov-perf-metrics {
    grid-template-columns: 1fr !important;
    gap: 0.5rem;
  }

  .ov-perf-metric {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.625rem 0.75rem;

    &__top {
      margin-bottom: 0;
      flex-direction: row;
      align-items: center;
    }

    &__value {
      font-size: 1.2rem;
      margin-bottom: 0;
    }

    &__label {
      font-size: 0.6rem;
    }

    &__icon {
      width: 34px;
      height: 34px;
      flex-shrink: 0;
    }
  }

  // ── Summary cards ─────────────────────────────────────────
  .ov-summary-cards--fullwidth {
    gap: 0.375rem;
  }

  .ov-summary-card__icon {
    width: 28px;
    height: 28px;
    border-radius: 6px;
  }

  .ov-summary-card__num {
    font-size: 0.95rem;
  }

  .ov-summary-card__lbl {
    font-size: 0.58rem;
  }

  // ── Classes ───────────────────────────────────────────────
  .ov-class-item {
    gap: 0.4rem;

    &--live {
      margin: 0 -0.625rem;
      padding: 0.6rem 0.625rem;
    }
  }

  .ov-class-item__time {
    width: 26px;
    font-size: 0.63rem;
  }

  .ov-class-item__name {
    font-size: 0.74rem;
  }

  // ── Task pills ────────────────────────────────────────────
  .ov-task-filter-btn {
    font-size: 0.65rem;
    padding: 0.25rem 0.4rem;
  }

  .ov-task-filter-badge {
    font-size: 0.58rem;
    padding: 0.03rem 0.35rem;
  }

  // ── Task items ────────────────────────────────────────────
  .ov-task-check {
    width: 20px;
    height: 20px;
  }

  .ov-task-title {
    font-size: 0.74rem;
  }

  .ov-task-due {
    font-size: 0.6rem;
  }

  // ── Notice board ─────────────────────────────────────────
  .ov-notice-item {
    padding: 0.55rem 0.45rem;

    &__icon {
      width: 26px;
      height: 26px;
      font-size: 0.8rem;
    }

    &__title {
      font-size: 0.74rem;
    }

    &__desc {
      font-size: 0.65rem;
    }
  }

  // ── Alert cards ───────────────────────────────────────────
  .ov-alert-card {
    padding: 0.5rem;

    &__title {
      font-size: 0.74rem;
    }

    &__desc {
      font-size: 0.66rem;
    }
  }

  // ── Work actions ─────────────────────────────────────────
  .ov-work__action-btn {
    font-size: 0.62rem;
    padding: 0.55rem 0.25rem;
  }

  .ov-work__action-icon {
    width: 26px;
    height: 26px;
  }

  // ── AI recs ───────────────────────────────────────────────
  .ov-ai-rec {
    padding: 0.65rem;

    &__title {
      font-size: 0.78rem;
    }

    &__desc {
      font-size: 0.68rem;
    }

    &__action {
      font-size: 0.68rem;
    }
  }

  // ── Performers ───────────────────────────────────────────
  .ov-performer-panel {
    padding: 0.65rem;
  }

  .ov-performer-name {
    font-size: 0.74rem;
  }

  .ov-performer-cls {
    font-size: 0.6rem;
  }

  .ov-performer-rank {
    width: 20px;
    height: 20px;
    font-size: 0.62rem;
  }

  // ── Buttons ───────────────────────────────────────────────
  .ov-btn-submit-tasks {
    padding: 0.6rem;
    font-size: 0.78rem;
  }

  .ov-btn-review {
    padding: 0.55rem;
    font-size: 0.76rem;
  }

  .ov-btn-mark {
    padding: 0.28rem 0.45rem;
    font-size: 0.64rem;
  }
}


// ────────────────────────────────────────────────────────────────
// 2.  390px  — summary cards wrap to 2×2, tighten all spacing
// ────────────────────────────────────────────────────────────────
@media (max-width: 390px) {

  .ov-page {
    padding: 0.625rem 0.375rem;
  }

  // ── Greeting ──────────────────────────────────────────────
  .ov-greeting__title {
    font-size: 1.15rem;
  }

  .ov-greeting__sub {
    font-size: 0.75rem;
  }

  .ov-greeting__date {
    font-size: 0.62rem;
  }

  // ── Panels ────────────────────────────────────────────────
  .ov-panel {
    padding: 0.625rem 0.5rem;
    border-radius: 8px;
  }

  // ── Summary cards → 2-col wrap ────────────────────────────
  .ov-summary-cards--fullwidth {
    flex-wrap: wrap;
    gap: 0.375rem;
  }

  .ov-summary-cards--fullwidth .ov-summary-card {
    flex: 1 1 calc(50% - 0.375rem);
    min-width: 0;
    box-sizing: border-box;
  }

  .ov-summary-card__icon {
    width: 26px;
    height: 26px;
  }

  .ov-summary-card__num {
    font-size: 0.9rem;
  }

  .ov-summary-card__lbl {
    font-size: 0.57rem;
  }

  // ── Classes ───────────────────────────────────────────────
  .ov-class-item--live {
    // margin: 0 -0.5rem;
    padding: 0.55rem 0.5rem;
  }

  .ov-class-item__time {
    width: 24px;
    font-size: 0.6rem;
  }

  .ov-class-item__name {
    font-size: 0.7rem;
  }

  // ── Task filter pills ─────────────────────────────────────
  .ov-tasks-filters--fullwidth {
    gap: 0.2rem;
  }

  .ov-task-filter-btn {
    font-size: 0.62rem;
    padding: 0.22rem 0.35rem;
  }

  // ── Task items ────────────────────────────────────────────
  .ov-task-check {
    width: 18px;
    height: 18px;
  }

  .ov-task-title {
    font-size: 0.7rem;
  }

  .ov-task-due {
    font-size: 0.58rem;
  }

  // ── Notice board ─────────────────────────────────────────
  .ov-notice-item {
    padding: 0.5rem 0.4rem;

    &__icon {
      width: 24px;
      height: 24px;
      font-size: 0.75rem;
    }

    &__title {
      font-size: 0.7rem;
    }

    &__desc {
      font-size: 0.62rem;
    }
  }

  // ── Work actions ─────────────────────────────────────────
  .ov-work__action-btn {
    font-size: 0.6rem;
    padding: 0.5rem 0.2rem;
  }

  .ov-work__action-icon {
    width: 24px;
    height: 24px;
  }

  // ── Perf metric ───────────────────────────────────────────
  .ov-perf-metric__value {
    font-size: 1.1rem;
  }

  .ov-perf-metric__icon {
    width: 30px;
    height: 30px;
  }

  // ── AI recs ───────────────────────────────────────────────
  .ov-ai-rec {
    padding: 0.6rem;

    &__title {
      font-size: 0.74rem;
    }

    &__desc {
      font-size: 0.65rem;
    }
  }

  // ── Performers ───────────────────────────────────────────
  .ov-performer-panel {
    padding: 0.625rem;
  }

  .ov-performer-name {
    font-size: 0.7rem;
  }

  // ── Panel header ─────────────────────────────────────────
  .ov-panel__title {
    font-size: 0.8rem;
  }

  .ov-panel__sub {
    font-size: 0.65rem;
  }

  // ── Buttons ───────────────────────────────────────────────
  .ov-btn-submit-tasks {
    font-size: 0.76rem;
    padding: 0.55rem;
  }

  .ov-btn-review {
    font-size: 0.74rem;
    padding: 0.5rem;
  }

  .ov-btn-mark {
    font-size: 0.62rem;
  }
}


// ────────────────────────────────────────────────────────────────
// 3.  320px  — most compact layout, everything stacked
// ────────────────────────────────────────────────────────────────
@media (max-width: 320px) {

  .ov-page {
    padding: 0.5rem 0.25rem;
  }

  // ── Greeting ──────────────────────────────────────────────
  .ov-greeting__title {
    font-size: 1rem;
  }

  .ov-greeting__sub {
    font-size: 0.7rem;
  }

  .ov-greeting__date {
    font-size: 0.6rem;
  }

  // ── Panels ────────────────────────────────────────────────
  .ov-panel {
    padding: 0.5rem 0.375rem;
    border-radius: 6px;
  }

  // ── Summary cards → full-width row ────────────────────────
  .ov-summary-cards--fullwidth .ov-summary-card {
    flex: 1 1 100%;
    flex-direction: row;
    text-align: left;
    justify-content: flex-start;
    gap: 0.5rem;
    padding: 0.25rem 0;
  }

  // ── Classes ───────────────────────────────────────────────
  .ov-class-item {
    gap: 0.3rem;
    padding: 0.4rem 0;

    &--live {
      margin: 0 -0.375rem;
      padding: 0.45rem 0.375rem;
    }
  }

  .ov-class-item__time {
    width: 22px;
    font-size: 0.58rem;
  }

  .ov-class-item__name {
    font-size: 0.67rem;
  }

  // ── Task filters ─────────────────────────────────────────
  .ov-task-filter-btn {
    font-size: 0.58rem;
    padding: 0.18rem 0.28rem;
    border-radius: 6px;
  }

  .ov-task-filter-badge {
    font-size: 0.52rem;
    padding: 0 0.25rem;
  }

  // ── Task items ────────────────────────────────────────────
  .ov-task-item {
    gap: 0.35rem;
    padding: 0.4rem 0.25rem;
  }

  .ov-task-check {
    width: 16px;
    height: 16px;
    margin-right: 0.3rem;
  }

  .ov-task-title {
    font-size: 0.67rem;
  }

  .ov-task-due {
    font-size: 0.56rem;
  }

  .ov-task-list {
    max-height: 250px;
  }

  // ── Notice board ─────────────────────────────────────────
  .ov-notice-item {
    padding: 0.4rem 0.325rem;
    border-radius: 6px;

    &__icon {
      width: 22px;
      height: 22px;
      font-size: 0.7rem;
    }

    &__title {
      font-size: 0.67rem;
    }

    &__desc {
      font-size: 0.6rem;
      line-height: 1.3;
    }

    &__time {
      font-size: 0.58rem;
    }
  }

  // ── Alert cards ───────────────────────────────────────────
  .ov-alert-card {
    gap: 0.3rem;
    padding: 0.375rem;

    &__title {
      font-size: 0.67rem;
    }

    &__desc {
      font-size: 0.6rem;
    }
  }

  // ── Work actions ─────────────────────────────────────────
  .ov-work__row {
    font-size: 0.68rem;
  }

  .ov-work__count {
    font-size: 0.68rem;
  }

  .ov-work__actions {
    gap: 0.3rem;
  }

  .ov-work__action-btn {
    padding: 0.4rem 0.15rem;
    font-size: 0.58rem;
    gap: 0.15rem;
  }

  .ov-work__action-icon {
    width: 22px;
    height: 22px;
  }

  // ── Perf metrics ─────────────────────────────────────────
  .ov-perf-metric {
    padding: 0.5rem 0.55rem;
    gap: 0.6rem;

    &__value {
      font-size: 1rem;
    }

    &__label {
      font-size: 0.56rem;
    }

    &__icon {
      width: 28px;
      height: 28px;
      font-size: 0.82rem;
    }

    &__delta {
      font-size: 0.58rem;
      padding: 0.08rem 0.3rem;
    }
  }

  // ── AI recs ───────────────────────────────────────────────
  .ov-ai-recs-title {
    font-size: 0.78rem;
  }

  .ov-ai-rec {
    padding: 0.5rem;
    border-radius: 7px;

    &__title {
      font-size: 0.7rem;
    }

    &__desc {
      font-size: 0.62rem;
      line-height: 1.3;
    }

    &__action {
      font-size: 0.63rem;
    }
  }

  // ── Charts ────────────────────────────────────────────────
  .ov-chart-panel {
    padding: 0.5rem;

    &__head {
      font-size: 0.7rem;
      margin-bottom: 0.4rem;
    }
  }

  // ── Performers ───────────────────────────────────────────
  .ov-performer-panel {
    padding: 0.5rem;
    border-radius: 7px;
  }

  .ov-performer-row {
    gap: 0.35rem;
    padding: 0.3rem 0;
  }

  .ov-performer-rank {
    width: 18px;
    height: 18px;
    font-size: 0.58rem;
    border-radius: 4px;
  }

  .ov-performer-icon-orange {
    width: 20px;
    height: 20px;
    border-radius: 4px;
  }

  .ov-performer-name {
    font-size: 0.67rem;
  }

  .ov-performer-cls {
    font-size: 0.57rem;
  }

  // ── Compliance ───────────────────────────────────────────
  .ov-compliance-item__header {
    font-size: 0.68rem;
  }

  .ov-compliance-item__sub {
    font-size: 0.6rem;
  }

  .ov-compliance-item__icon {
    width: 20px;
    height: 20px;
  }

  // ── Announcements ────────────────────────────────────────
  .ov-ann-new {
    &__input {
      font-size: 0.68rem;
      padding: 0.3rem 0.4rem;
    }

    &__save {
      font-size: 0.68rem;
      padding: 0.3rem 0.5rem;
    }
  }

  .ov-ann-item__title {
    font-size: 0.68rem;
  }

  .ov-ann-item__sub {
    font-size: 0.62rem;
  }

  // ── Buttons ───────────────────────────────────────────────
  .ov-btn-submit-tasks {
    padding: 0.5rem;
    font-size: 0.72rem;
    border-radius: 7px;
  }

  .ov-btn-review {
    padding: 0.45rem;
    font-size: 0.7rem;
  }

  .ov-btn-mark {
    padding: 0.22rem 0.35rem;
    font-size: 0.6rem;
    border-radius: 5px;
  }

  // ── Panel header ─────────────────────────────────────────
  .ov-panel__title {
    font-size: 0.76rem;
  }

  .ov-panel__sub {
    font-size: 0.62rem;
  }

  .ov-tasks-title-icon {
    width: 26px;
    height: 26px;
    border-radius: 6px;
  }

  .ov-tasks-panel__title {
    font-size: 0.74rem;
  }

  .ov-tasks-panel__sub {
    font-size: 0.6rem;
  }

  .ov-tasks-progress-pct {
    font-size: 0.95rem;
  }

  // ── Links / small text ───────────────────────────────────
  .ov-link-footer {
    font-size: 0.67rem;
    margin-top: 0.5rem;
  }

  .ov-link-sm {
    font-size: 0.67rem;
  }

  .ov-mark-read-btn {
    font-size: 0.58rem;
    padding: 0.08rem 0.3rem;
  }

  // ── Badge sizes ──────────────────────────────────────────
  .ov-badge {
    font-size: 0.58rem;
    padding: 0.12rem 0.38rem;
  }
}