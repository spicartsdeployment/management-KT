{
  "name": "@school-hrms/school-ui",
  "version": "1.0.0",
  "description": "School HRMS - School UI Package (Transport, Attendance, etc.)",
  "main": "dist/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "webpack serve --mode development",
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "watch": "webpack --mode development --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .js,.jsx",
    "lint:fix": "eslint src --ext .js,.jsx --fix",
    "analyze": "ANALYZE=true webpack --mode production"
  },
  "keywords": [
    "school",
    "hrms",
    "transport",
    "bus-tracking",
    "attendance"
  ],
  "author": "School HRMS Team",
  "license": "MIT",
  "dependencies": {
    "@school-hrms/utility": "^1.0.0",
    "@heroicons/react": "^2.0.18",
    "@tanstack/react-query": "^5.96.2",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "geolib": "^3.3.4",
    "leaflet": "^1.9.4",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-error-boundary": "^4.0.11",
    "react-hook-form": "^7.71.2",
    "react-leaflet": "^4.2.1",
    "recharts": "^2.15.4",
    "redux-mock-store": "^1.5.5",
    "vite": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.0",
    "@tanstack/react-query-devtools": "^5.96.2",
    "@testing-library/jest-dom": "^6.1.4",
    "@testing-library/react": "^14.1.2",
    "@testing-library/user-event": "^14.5.1",
    "babel-jest": "^29.7.0",
    "babel-loader": "^9.1.3",
    "css-loader": "^6.8.1",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^8.53.0",
    "eslint-plugin-jest": "^27.6.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "mini-css-extract-plugin": "^2.7.6",
    "sass": "^1.69.5",
    "sass-loader": "^13.3.2",
    "style-loader": "^3.3.3",
    "terser-webpack-plugin": "^5.3.9",
    "webpack": "^5.89.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.3"
  },
  "peerDependencies": {
    "@school-hrms/common-components": "^1.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.js"
    ],
    "moduleNameMapper": {
      "\\.(css|scss|sass)$": "identity-obj-proxy",
      "config/env$": "<rootDir>/__mocks__/config/env.js",
      "services/api/apiClient$": "<rootDir>/__mocks__/services/api/apiClient.js",
      "apiClient$": "<rootDir>/__mocks__/services/api/apiClient.js",
      "^@school-hrms/utility$": "<rootDir>/__mocks__/@school-hrms/utility.js",
      "^@school-hrms/common-components/(.+)$": "<rootDir>/../hrms-common-components/src/$1",
      "^@school-hrms/common-components$": "<rootDir>/../hrms-common-components/src",
      "components/MapView$": "<rootDir>/src/components/MapView",
      "services/socket/busSocket": "<rootDir>/src/services/socket/busSocket"
    },
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!@school-hrms)"
    ],
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/**/*.test.{js,jsx}",
      "!src/setupTests.js",
      "!src/index.jsx"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  }
}
