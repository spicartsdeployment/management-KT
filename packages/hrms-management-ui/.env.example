# =============================================================================
# ERP_Management — environment variables
# -----------------------------------------------------------------------------
# Copy to .env and adjust per environment. Vite picks up VITE_* at build time.
# Each variable maps a frontend service module to a Django microservice URL.
# =============================================================================

# ---- Per-service base URLs --------------------------------------------------
# Default ports match backend/Management/<service>/manage.py runserver.
#
#   service           env var                          local URL                Django prefix
#   ────────────────────────────────────────────────────────────────────────────
#   dashboard         VITE_MGMT_DASHBOARD_API          http://localhost:8001    /dashboard/
#   fees              VITE_MGMT_FEES_API               http://localhost:8002    /fees/
#   transport         VITE_MGMT_TRANSPORT_API          http://localhost:8003    /transport/
#   grievances        VITE_MGMT_GRIEVANCES_API         http://localhost:8004    /grievances/
#   announcements     VITE_MGMT_ANNOUNCEMENTS_API      http://localhost:8005    /announcements/
#   events            VITE_MGMT_EVENTS_API             http://localhost:8006    /events/
#   policies          VITE_MGMT_POLICIES_API           http://localhost:8007    /policies/
#   staff             VITE_MGMT_STAFF_API              http://localhost:8008    /staff/

VITE_MGMT_DASHBOARD_API=http://localhost:8001
VITE_MGMT_FEES_API=http://localhost:8002
VITE_MGMT_TRANSPORT_API=http://localhost:8003
VITE_MGMT_GRIEVANCES_API=http://localhost:8004
VITE_MGMT_ANNOUNCEMENTS_API=http://localhost:8005
VITE_MGMT_EVENTS_API=http://localhost:8006
VITE_MGMT_POLICIES_API=http://localhost:8007
VITE_MGMT_STAFF_API=http://localhost:8008

# Fallback used when a per-service URL isn't set (also used by the Auth service).
VITE_MGMT_API_BASE=http://localhost:8000

# ---- Auth -------------------------------------------------------------------
# JWT key in localStorage. Keep this aligned with ERP_Transport so a user
# logged in on one portal is recognised on the other.
VITE_AUTH_TOKEN_KEY=edgiant_token

# ---- Tenant context ---------------------------------------------------------
# Sent as ?schoolId / ?branchId / ?academicYear on every API call. Replace
# with values bound at login when multi-tenant routing lands.
VITE_DEFAULT_SCHOOL_ID=1
VITE_DEFAULT_BRANCH_ID=1
VITE_DEFAULT_ACADEMIC_YEAR=2025-26
