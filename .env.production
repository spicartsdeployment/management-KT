# Production environment overrides
# Loaded by Vite when running: vite build (mode=production)
# This file is committed — do NOT put secrets here.
# Put production secrets in .env.production.local (git-ignored).

# ── Backend servers (production) ────────────────────────────────────────────────────
# In production all traffic routes through dedicated Edgiant microservices.
VITE_API_LOCAL_SERVER=
VITE_API_DEV=

# ── WebSocket (production) ─────────────────────────────────────────────────────
VITE_WS_LOCAL=
VITE_WS_SERVER=wss://edgiantsocketcontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io/ws
VITE_WS_DEV=

# ── Microservice URLs (production) ─────────────────────────────────────────────
VITE_API_AUTH_SERVER=https://edgiantauthcontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io/authentication
VITE_API_ANNOUNCEMENTS_SERVER=https://edgiantannouncementscontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_API_ALUMNI_SERVER=https://edgiantalumnicontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_API_BUS_TRACKING_SERVER=https://edgiantbustrackingcontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_API_COMMUNITY_SERVER=https://edgiantcommunitycontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_API_OVERVIEW_SERVER=https://edgiantoverviewcontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_API_PERFORMANCE_SERVER=https://edgiantperfomancecontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_API_SCHEDULE_SERVER=https://edgiantschedulecontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_API_LEAVE_SERVER=https://edgiantleavecontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_API_GRIEVANCE_SERVER=https://edgiantgrievancecontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_API_MEETINGS_SERVER=https://edgiantmeetingscontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_API_TEACHER_SERVER=https://edgiantteachercontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io
VITE_WS_TEACHER_SERVER=wss://edgiantteachercontainerapp.orangeflower-ec7149d5.centralindia.azurecontainerapps.io/ws

# ── Environment ────────────────────────────────────────────────────────────────
VITE_NODE_ENV=production

# ── Feature flags ──────────────────────────────────────────────────────────────
VITE_ENABLE_BUS_TRACKING=true
VITE_ENABLE_ATTENDANCE=true
VITE_ENABLE_COMMUNICATION=true

# ── Map ────────────────────────────────────────────────────────────────────────
VITE_MAP_DEFAULT_CENTER_LAT=28.6139
VITE_MAP_DEFAULT_CENTER_LNG=77.2090
VITE_MAP_DEFAULT_ZOOM=12
