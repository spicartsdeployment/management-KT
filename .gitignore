# ─────────────────────────────────────────────────────────────────────────────
# Environment files
#
# .env             — safe defaults (URLs, feature flags) — COMMITTED ✅
# .env.example     — template for team onboarding       — COMMITTED ✅
# .env.production  — production overrides (no secrets)  — COMMITTED ✅
# .env.local       — personal overrides & SECRETS       — IGNORED  🚫
# .env.*.local     — environment-specific local secrets — IGNORED  🚫
# ─────────────────────────────────────────────────────────────────────────────
.env.local
.env.development.local
.env.test.local
.env.production.local

